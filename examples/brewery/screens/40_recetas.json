    {
      "id": "rol0",
      "kind": "text",
      "x": 26,
      "y": 502,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Observador: consulta todas las pantallas.",
        "en": "• Observer: See all screens."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
    },
    {
      "id": "rol1",
      "kind": "text",
      "x": 26,
      "y": 554,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Operador de cocción: elige receta y fermentador, manda la secuencia y reconoce alarmas.",
        "en": "• Brewing operator: choose recipe and fermenter, send the sequence and recognize alarms."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
    },
    {
      "id": "rol2",
      "kind": "text",
      "x": 26,
      "y": 606,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Maestro cervecero: además, modifica y guarda recetas.",
        "en": "• Brewmaster: also modify and save recipes."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
    },
    {
      "id": "rol3",
      "kind": "text",
      "x": 26,
      "y": 658,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Administrador: todo, más usuarios y acceso por OPC UA.",
        "en": "• Administrator: everything, more users and access through OPC UA."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
    },
    {
      "id": "rol4",
      "kind": "text",
      "x": 26,
      "y": 710,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Cliente MES: solo lee por el servidor OPC UA del SCADA.",
        "en": "• MES Client: only reads through the SCADA OPC UA server."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
    },
    {
      "id": "rol5",
      "kind": "text",
      "x": 26,
      "y": 762,
      "w": 316,
      "h": 50,
      "text": {
        "es": "• Un lote en marcha usa la copia de la receta tomada al iniciar: guardar no lo altera.",
        "en": "• A running batch uses the copy of the recipe taken at startup: saving does not alter it."
      },
      "font_size": 12,
      "bold": false,
      "text_color": "#24292e",
      "text_align": "left"
