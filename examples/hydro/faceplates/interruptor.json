{
  "title": {
    "es": "Interruptor",
    "en": "switch"
  },
  "width": 44,
  "height": 44,
  "background": "#dde1e4",
  "parameters": {
    "cerrado": "bool"
  },
  "elements": [
    {
      "id": "cuerpo",
      "kind": "rectangle",
      "x": 2,
      "y": 2,
      "w": 40,
      "h": 40,
      "color": "#2e7d32",
      "stroke_color": "#1f2a33",
      "stroke_width": 2,
      "dynamics": {
        "states": [
          {
            "when": {
              "tag": "$cerrado",
              "op": "eq",
              "value": true,
              "bad": false
            },
            "style": {
              "color": "#c62828"
            }
          }
        ],
        "bad": {
          "color": "#e89a1c"
        }
      }
    },
    {
      "id": "estado",
      "kind": "text_list",
      "x": 2,
      "y": 2,
      "w": 40,
      "h": 40,
      "tag": "$cerrado",
      "font_size": 16,
      "bold": true,
      "text_color": "#ffffff",
      "color": "#00000000",
      "border_color": "#00000000",
      "texts": [
        {
          "value": "true",
          "text": {
            "es": "I",
            "en": "I"
          }
        },
        {
          "value": "false",
          "text": {
            "es": "O",
            "en": "Or"
          }
        }
      ],
      "default_text": {
        "es": "?",
        "en": "?"
      }
    }
  ]
}
