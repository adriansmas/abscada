{
  "title": "Bomba",
  "width": 50,
  "height": 50,
  "background": "@Panel",
  "parameters": {
    "marcha": "bool",
    "fallo": "bool"
  },
  "elements": [
    {
      "id": "cuerpo",
      "kind": "ellipse",
      "x": 3,
      "y": 3,
      "w": 44,
      "h": 44,
      "color": "@Paro",
      "stroke_color": "@Texto",
      "stroke_width": 2,
      "dynamics": {
        "states": [
          {
            "when": {
              "tag": "$fallo",
              "op": "eq",
              "value": true,
              "bad": false
            },
            "style": {
              "color": "@Disparo"
            }
          },
          {
            "when": {
              "tag": "$marcha",
              "op": "eq",
              "value": true,
              "bad": false
            },
            "style": {
              "color": "@Marcha"
            }
          }
        ],
        "bad": {
          "color": "@Aviso"
        }
      }
    },
    {
      "id": "rodete",
      "kind": "polyline",
      "x": 16,
      "y": 13,
      "w": 22,
      "h": 24,
      "stroke_color": "#ffffff",
      "stroke_width": 3,
      "points": [
        [
          0.0,
          0.0
        ],
        [
          1.0,
          0.5
        ],
        [
          0.0,
          1.0
        ],
        [
          0.0,
          0.0
        ]
      ]
    }
  ]
}
