          "color": "#e3e6e9",
          "text_color": "#8a949d",
          "border_color": "#b4bbc2"
        },
        "disabled_reason": {
          "es": "Aliviadero en automático: la consigna la calcula el PLC",
          "en": "Automatic spillway: the setpoint is calculated by the PLC"
        }
      }
    },
    {
      "id": "modo",
      "kind": "text_list",
      "x": 80,
      "y": 142,
      "w": 150,
      "h": 28,
      "tag": "$automatico",
      "font_size": 12,
      "bold": true,
      "text_color": "#ffffff",
      "color": "#6c7882",
      "border_color": "#6c7882",
      "texts": [
        {
          "value": "true",
          "text": {
            "es": "AUTOMÁTICO",
            "en": "AUTOMATIC"
          }
        },
        {
          "value": "false",
          "text": {
            "es": "MANUAL",
            "en": "MANUAL"
          }
        }
      ],
      "default_text": {
        "es": "—",
        "en": "—"
      },
      "dynamics": {
        "states": [
          {
            "when": {
              "tag": "$automatico",
              "op": "eq",
              "value": false,
              "bad": false
