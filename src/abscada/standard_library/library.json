    "bomba_estado": {
      "title": {
        "es": "Bomba con estado",
        "en": "Stateful bomb"
      },
      "folder": "Objetos",
      "width": 100,
      "height": 100,
      "parameters": {
        "marcha": "bool",
        "fallo": "bool"
      },
      "elements": [
        {
          "id": "simbolo",
          "kind": "image",
          "x": 0,
          "y": 0,
          "w": 100,
          "h": 100,
          "source": "objetos/bomba_paro.svg",
          "dynamics": {
            "states": [
              {
                "when": {
                  "tag": "$fallo",
                  "op": "eq",
                  "value": true,
                  "bad": false
                },
                "style": {
                  "source": "objetos/bomba_fallo.svg"
                }
              },
              {
                "when": {
                  "tag": "$marcha",
                  "op": "eq",
                  "value": true,
                  "bad": false
                },
                "style": {
                  "source": "objetos/bomba_marcha.svg"
                }
              }
            ],
            "bad": {
              "source": "objetos/bomba_dudoso.svg"
            }
          }
        }
      ]
    },
